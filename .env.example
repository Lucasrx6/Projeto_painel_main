# ─────────────────────────────────────────────────────────────
# Banco de dados principal (PostgreSQL)
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432
DB_POOL_MIN=5
DB_POOL_MAX=15
DB_POOL_BUDGET=20
DB_USE_POOL=true

# ─────────────────────────────────────────────────────────────
# Banco de dados da Auditoria (banco separado: 'auditoria')
# Se AUDIT_DB_* não forem definidos, cai nos DB_* acima.
# ─────────────────────────────────────────────────────────────
AUDIT_DB_HOST=localhost
AUDIT_DB_NAME=auditoria
AUDIT_DB_USER=postgres
AUDIT_DB_PASSWORD=
AUDIT_DB_PORT=5432

# Alternativa: URL completa (tem precedência sobre as vars acima)
# AUDITORIA_DB_URL=postgresql://auditoria_app:senha@localhost:5432/auditoria

# ─────────────────────────────────────────────────────────────
# Flask
# ─────────────────────────────────────────────────────────────
SECRET_KEY=
FLASK_ENV=production
HTTPS_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Redis (cache opcional)
# ─────────────────────────────────────────────────────────────
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=120

# ─────────────────────────────────────────────────────────────
# Auditoria — segurança e ambiente
# ─────────────────────────────────────────────────────────────

# Segredo HMAC para pseudonimização de identificadores pessoais (LGPD).
# OBRIGATÓRIO: mínimo 32 caracteres, gerado aleatoriamente.
# NUNCA compartilhe, logue, imprima ou comite este valor.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
AUDITORIA_HMAC_SECRET=

# Ambiente: development | staging | production
AUDITORIA_AMBIENTE=production

# Número máximo de jobs de auditoria simultâneos
AUDITORIA_JOBS_MAX=2

# ─────────────────────────────────────────────────────────────
# IA externa (Groq) — DESLIGADA por padrão
# Requer AMBOS para habilitar: IA_HABILITADA=true E
# audit.parametro('ia_externa_autorizada')='true' no banco.
# ─────────────────────────────────────────────────────────────

# Chave da API Groq — obtenha em console.groq.com
# NUNCA comite este valor. Mantenha apenas no .env em produção.
GROQ_API_KEY=

# Modelo a usar (padrão: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Timeout de chamada à API Groq em segundos
GROQ_TIMEOUT_S=30

# Máximo de retentativas em falhas de rede/429/5xx
GROQ_MAX_RETRIES=3

# Máximo de caracteres enviados por chamada (textos maiores são truncados)
GROQ_PAYLOAD_MAX_CHARS=3000

# Máximo de chamadas por job de análise (proteção contra loop)
GROQ_MAX_CALLS_JOB=20

# Quantidade máxima razoável por item extraído (proteção contra alucinação)
GROQ_QTD_MAX=9999

# Habilita a IA externa (false por padrão — ligue apenas em homologação confirmada)
IA_HABILITADA=false

# ─────────────────────────────────────────────────────────────
# SMTP (Gmail — para notificações, se habilitado)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─────────────────────────────────────────────────────────────
# ntfy push
# ─────────────────────────────────────────────────────────────
NTFY_URL=https://ntfy.sh

# ─────────────────────────────────────────────────────────────
# Apache Hop (freshness)
# ─────────────────────────────────────────────────────────────
HOP_SERVER_HOST=localhost
HOP_SERVER_PORT=8080
HOP_FRESHNESS_AVISO_H=4
HOP_FRESHNESS_ERRO_H=24

# ─────────────────────────────────────────────────────────────
# Thresholds de monitoramento
# ─────────────────────────────────────────────────────────────
MONITOR_CPU_AVISO=75
MONITOR_CPU_ERRO=90
MONITOR_MEM_AVISO=80
MONITOR_MEM_ERRO=90
MONITOR_DISK_AVISO=80
MONITOR_DISK_ERRO=90
MONITOR_DB_CONN_AVISO=70
MONITOR_DB_CONN_ERRO=90
MONITOR_DB_LAT_AVISO=500
MONITOR_DB_LAT_ERRO=2000
